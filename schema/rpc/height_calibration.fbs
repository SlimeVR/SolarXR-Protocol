namespace solarxr_protocol.rpc;

table StartUserHeightCalibration {}

table CancelUserHeightCalibration {}

enum UserHeightCalibrationStatus: uint8 {
    NONE = 0,
    RECORDING_FLOOR = 1,
    WAITING_FOR_CONTROLLER_PITCH = 2,
    WAITING_FOR_RISE = 3,
    WAITING_FOR_FW_LOOK = 4,
    RECORDING_HEIGHT = 5,
    DONE = 6,
    ERROR_TOO_HIGH = 7,
    ERROR_TOO_SMALL = 8,
    ERROR_TIMEOUT = 9
}

table UserHeightRecordingStatusResponse {
    hmd_height: float;
    status: UserHeightCalibrationStatus;
}
