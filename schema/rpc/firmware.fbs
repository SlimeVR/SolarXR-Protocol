namespace solarxr_protocol.rpc;

enum FirmwareUpdateStatus: uint8 {
    /// The server is downloading the firmware
    DOWNLOADING,
    /// The server is waiting for the tracker to be rebooted by the user
    /// Note that is is not the same as REBOOTING
    NEED_MANUAL_REBOOT,
    /// The server tries to authenticate with the MCU
    AUTHENTICATING,
    /// The server is uploading the firmware to the Device
    UPLOADING,
    /// The serial flasher tries to sync with the MCU
    /// You can use this event to prompt the user to press the boot btn
    SYNCING_WITH_MCU,
    /// The MCU is rebooting
    REBOOTING,
    /// The server is provisioning the tracker
    PROVISIONING,
    /// The update process completed with success
    DONE,
    /// Could not find the device
    ERROR_DEVICE_NOT_FOUND,
    /// The operation timed out, > 1min
    ERROR_TIMEOUT,
    /// The firmware download failed
    ERROR_DOWNLOAD_FAILED,
    /// The server could not authenticate with the MCU
    ERROR_AUTHENTICATION_FAILED,
    /// Could not upload the firmware to the MCU
    ERROR_UPLOAD_FAILED,
    /// The provision of the tracker failed, usually wifi credentials
    ERROR_PROVISIONING_FAILED,
    /// An unsupported Flashing method was used
    ERROR_UNSUPPORTED_METHOD,
    ERROR_UNKNOWN,
    /// The server asked the device to reboot into its USB bootloader
    ENTERING_BOOTLOADER,
    /// The server is waiting for the bootloader drive of the device to appear
    WAITING_FOR_DRIVE,
}

table SerialDevicePort {
    port: string;
}

table FirmwareDeviceIdTable {
    id: uint16;
}

/// Hardware id reported by the device, the same in application and bootloader mode
table FirmwareHardwareId {
    id: string;
}

union FirmwareUpdateDeviceId {
    FirmwareDeviceIdTable,
    SerialDevicePort,
    FirmwareHardwareId,
}

table FirmwarePart {
    /// Url of the firmware bin to download
    url: string;
    /// Offset of the firmware, used when flashing to the mcu, it indicates where to write this file in memory
    /// Will be ignored in the case of OTA flashing
    offset: uint;
    /// Checksum of the file
    digest: string;
}

union FirmwareUpdateMethod {
    OTAFirmwareUpdate,
    SerialFirmwareUpdate,
    UsbFirmwareUpdate
}

table FirmwareUpdateRequest {
    method: FirmwareUpdateMethod;
}

table OTAFirmwareUpdate {
    /// Id of the device
    device_id: uint16;
    /// A table containing the url and offset of the firmware bin file
    firmware_part: FirmwarePart;
}

table SerialFirmwareUpdate {
    /// id of the device, this refer to a serial port id
    device_id: SerialDevicePort;
    /// Will make the server ask for the tracker to be manually rebooted by the user
    /// after the tracker is done flashing
    need_manual_reboot: bool;
    /// Credentials to provision after the flashing
    /// Only used with Serial flashing, because OTA is already connected to the wifi
    ssid: string;
    password: string;
    /// A list of urls and offsets of the different firmware files to flash
    firmware_part: [FirmwarePart];
}

table UsbFirmwareUpdate {
    device_id: FirmwareHardwareId;
    /// The uf2 files to copy to the bootloader drive, in order. A bootloader update goes first
    firmware_part: [FirmwarePart];
}

table FirmwareUpdateStatusResponse {
    device_id: FirmwareUpdateDeviceId;
    status: FirmwareUpdateStatus;
    /// from 0 to 100
    progress: int8;
}

// This will cancel all pending updates
table FirmwareUpdateStopQueuesRequest {}

/// How the firmware of a device compares to the latest release
enum FirmwareVersionStatus: uint8 {
    /// No release info yet, or the device version could not be parsed
    UNKNOWN = 0,
    UP_TO_DATE = 1,
    AVAILABLE = 2,
    /// The device is below the minimum version of the release
    REQUIRED = 3,
    /// An update exists but this user is outside its rollout
    BLOCKED = 4,
    /// The server does not check updates for this device
    UNSUPPORTED = 5,
}

/// Why an available or required update cannot start right now
enum FirmwareUpdateBlocker: uint8 {
    NONE = 0,
    /// The battery is too low to update safely
    LOW_BATTERY = 1,
    /// The device needs to be plugged in with USB first
    NEEDS_USB = 2,
}

enum FirmwareUpdatePolicy: uint8 {
    /// Trackers on a device that requires an update are not used
    BLOCK = 0,
    /// Required updates are only shown
    WARN = 1,
}

table FirmwareUpdateDevice {
    device_id: FirmwareUpdateDeviceId;
    status: FirmwareVersionStatus;
    blocker: FirmwareUpdateBlocker;
    method: FirmwareUpdateMethod;
    latest_version: string;
    min_version: string;
    policy: FirmwareUpdatePolicy;
}

table FirmwareUpdatesRequest {}

/// Sent in full every time the update status of any device changes
table FirmwareUpdatesResponse {
    devices: [FirmwareUpdateDevice];
}
