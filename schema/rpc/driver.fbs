namespace solarxr_protocol.rpc;

// Driver output settings request and response. Covers whatever is connected over
// the driver IPC, SteamVR or Monado.
// Which bones the driver receives is bone routing, see bone_routing.fbs.
table DriverSettingsRequest {}
table DriverSettingsResponse {
    enabled: bool;
}
table ChangeDriverSettingsRequest {
    enabled: bool;
}

enum DriverConnectionState : ubyte {
    UNSUPPORTED = 0,
    DISABLED,
    WAITING,
    CONNECTED,
}

table DriverStatusRequest {}
table DriverStatusChangeResponse {
    state: DriverConnectionState;
}
