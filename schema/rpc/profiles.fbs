namespace solarxr_protocol.rpc;

enum ProfileKind: uint8 {
    /// Not set, a request with this kind is rejected.
    UNKNOWN = 0,
    /// The machine: trackers, outputs, resets, keybinds and every other setting.
    SETTINGS,
    /// The person: height and bone proportions.
    USER
}

enum ProfileOperationStatus: uint8 {
    OK = 0,
    /// The request has no profile kind.
    INVALID_KIND,
    /// The name has characters that are not allowed, or is empty or too long.
    INVALID_NAME,
    /// A profile with this name already exists, names compare case-insensitively.
    ALREADY_EXISTS,
    /// No profile with this name exists.
    NOT_FOUND,
    /// The profile is in use (active), so the operation cannot be performed
    IS_ACTIVE,
    /// The server could not read or write the profile files.
    FAILED
}

table ProfileList {
    active: string;
    names: [string];
}

table ProfilesRequest {}

table ProfilesResponse {
    settings: ProfileList;
    user: ProfileList;
}

table SwitchProfileRequest {
    kind: ProfileKind;
    name: string;
}

table CreateProfileRequest {
    kind: ProfileKind;
    name: string;
    copy_from: string;
}

table RenameProfileRequest {
    kind: ProfileKind;
    name: string;
    new_name: string;
}

table DeleteProfileRequest {
    kind: ProfileKind;
    name: string;
}

table ProfileOperationResponse {
    status: ProfileOperationStatus;
}
