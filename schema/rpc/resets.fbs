namespace solarxr_protocol.rpc;

enum ResetType: uint8 {
    /// Resets the yaw (horizontal) axis
    YAW,
    /// Resets all axes
    FULL,
    /// Calibrates the mounting rotation with the configured MountingMethod
    MOUNTING,
}

table ResetRequest {
    reset_type: ResetType;
    /// Which body parts to reset. Server handles it if empty (usually all)
    body_parts: [solarxr_protocol.datatypes.BodyPart];
    delay: float = null;
}

enum ResetLifecycle: uint8 {
    RUNNING,
    DONE,
    CANCELED,
    FAILED,
}

/// A reset that runs after a delay (full, yaw and pose mounting)
table CountdownDetail {
    /// Seconds passed since the start of the reset, equal to 'duration' when it is done
    progress: int;
    duration: int;
}

enum StepMountingStatus: uint8 {
    WAITING_FOR_MOVEMENT,
    RECORDING,
    PROCESSING,
    ERROR_NO_DATA,
    ERROR_TIMEOUT,
}

/// A step mounting session
table StepMountingDetail {
    status: StepMountingStatus;
}

union ResetDetail {
    CountdownDetail,
    StepMountingDetail,
}

table ResetStatusResponse {
    reset_type: ResetType;
    lifecycle: ResetLifecycle;
    /// The body parts reset / being reset
    body_parts: [solarxr_protocol.datatypes.BodyPart];
    detail: ResetDetail;
}

/// Cancels the running reset, if any
table CancelResetRequest {}

/// Clears mounting reset data, defaulting to the manually set mounting orientations
table ClearMountingResetRequest {}

enum ArmsResetMode: uint8 {
    /// Down to the sides for full. Upper arm going back and forearm going forward for mounting.
    BACK,
    /// Down to the sides for full. Arms going forward for mounting.
    FORWARD,
    /// Down to the sides for full. T-pose for mounting.
    T_POSE_UP,
    /// T-pose for full. Down to the sides for mounting.
    T_POSE_DOWN
}

// Resets settings request and response
table ResetsSettingsRequest {}
table ResetsSettingsResponse {
    /// Makes it so feet will be always be mounting reset even when passing no BodyPart
    reset_mounting_feet: bool;
    arms_reset_mode: ArmsResetMode;
    /// In seconds, the time it takes to smooth to the corrected rotation when doing a yaw reset.
    yaw_reset_smooth_time: float32;
    /// Save mounting reset between restarts
    save_mounting_reset: bool;
    /// Reset VR headset's pitch and roll
    reset_reliable_reference_attitude: bool;
    /// How a MOUNTING reset calibrates the trackers
    mounting_method: solarxr_protocol.datatypes.MountingMethod;
}
table ChangeResetsSettingsRequest {
    /// Makes it so feet will be always be mounting reset even when passing no BodyPart
    reset_mounting_feet: bool;
    arms_reset_mode: ArmsResetMode;
    /// In seconds, the time it takes to smooth to the corrected rotation when doing a yaw reset.
    yaw_reset_smooth_time: float32;
    /// Save mounting reset between restarts
    save_mounting_reset: bool;
    /// Reset VR headset's pitch and roll
    reset_reliable_reference_attitude: bool;
    /// How a MOUNTING reset calibrates the trackers
    mounting_method: solarxr_protocol.datatypes.MountingMethod;
}
