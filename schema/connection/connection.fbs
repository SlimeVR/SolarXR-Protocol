include "../datatypes/datatypes.fbs";

namespace solarxr_protocol.connection;

table BoneDefinition {
    id: uint16;
    key: string (required);
    display_name: string;
    /// The parent's ID, or 0 if this bone has no parent (a root).
    parent: uint16;
    /// Present for standardized bones; extensions leave this absent.
    standard_body_part: solarxr_protocol.datatypes.BodyPart = null;
}

/// Authoritative, connection-wide bone identity and hierarchy: a flat list where
/// each definition names its own parent. IDs are compact registry-local handles;
/// persist keys and resolve them after reconnecting.
table BoneRegistry {
    bones: [BoneDefinition] (required);
}

table FinishConfiguration {}
table ConfigurationAcknowledged {}

enum ConnectionErrorCode: uint8 {
    UNKNOWN_BONE,
    INVALID_REGISTRY,
    INITIALIZATION_REQUIRED,
}

table ConnectionError {
    code: ConnectionErrorCode;
    message: string;
    bone_id: uint16;
}

union ConnectionMessage {
    BoneRegistry,
    FinishConfiguration,
    ConfigurationAcknowledged,
    ConnectionError,
}

table ConnectionMessageHeader {
    message: ConnectionMessage;
}
